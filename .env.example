# Storefront API — used to create the cart/checkout at /api/checkout
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2024-10
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Admin API — used to tag orders with the issued license key
SHOPIFY_ADMIN_API_VERSION=2024-10
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Register a webhook (Settings > Notifications > Webhooks, topic "Order payment",
# or `POST /admin/api/2024-10/webhooks.json` with topic "orders/paid") pointing at
# https://<your-domain>/api/webhooks/shopify, then paste its signing secret here
SHOPIFY_WEBHOOK_SECRET=

# Product variant IDs (numeric or gid://shopify/ProductVariant/... form both work)
SOURCE_CODE_VAIRANT_ID=
RENEWAL_VARIANT_ID=

# Resend — contact form (see /contact). Rendered as inline HTML.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Resend — sends the license key email after a paid order webhook fires.
# Rendered by our own code from emails/SourceCodeDeliveryEmail.tsx via
# @react-email/render (see lib/email.ts) — not a Resend-hosted Template, so
# no template ID to configure here.
RESEND_LICENSE_API_KEY=
RESEND_LICENSE_FROM_EMAIL=

# Absolute base URL the license email's <img> tags are built from (must serve
# public/email-assets/ over HTTPS — email clients can't reach localhost).
# Defaults to https://fidelabs.io/email-assets if unset. For local dev, point
# this at the dev tunnel instead, e.g. https://dev.request-quote.online/email-assets
EMAIL_ASSET_BASE_URL=

# Not tracked per-order anywhere yet, so these are fixed values shown on
# every license email until real version/size tracking exists.
PRODUCT_VERSION=1.0.0
PACKAGE_SIZE=Full Source Package (.zip)

# Postgres connection string (Prisma). Required for license issuance
# (lib/license.ts) — the orders/paid webhook can't record/tag licenses
# without it.
DATABASE_URL=

# Cloudinary — stores the generated license agreement PDF and (per
# scripts/uploadStaticPackages.ts) the static product/documentation zips.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Links sent in the license delivery email (see app/api/webhooks/shopify/route.ts).
# Point these at the Cloudinary-hosted (or other CDN) URLs produced by
# scripts/uploadStaticPackages.ts / scripts/generateTechnicalDocumentsZip.ts.
SOURCE_CODE_PACKAGE_URL=
DOCUMENTATION_BUNDLE_URL=
INSTALLATION_VIDEO_URL=
